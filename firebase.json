{
  "hosting": {
    "site": "kulkule",
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "**/.*", "**/node_modules/**", "README.md", "YONETIM.md"],
    "cleanUrls": true,
    "headers": [
      { "source": "icerik/**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "veri/**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(jpg|jpeg|png|webp)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  }
}
